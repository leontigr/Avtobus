      "default": "known",
      "reset": 2,
      "options": [
        [
          "known",
          "Все параметры, которые могут быть в блоке"
        ],
        [
          "answering",
          "Только параметры с ответом"
        ],
        [
          "all",
          "Все параметры из списка"
